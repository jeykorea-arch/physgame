# Firebase 웹 앱 설정값을 Firebase Console에서 확인해 .env.local에 복사하세요.
# .env.local은 .gitignore에 포함되어 GitHub에 올라가지 않습니다.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://replace_me-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me
